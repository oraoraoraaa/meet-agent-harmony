# Local configuration template
# Copy to .env (repo root) or paste keys in app Settings — never commit real secrets.

# --- Map provider (AMap Web REST preferred for live routes) ---
# Console: https://console.amap.com/  → Web服务 Key
# Enable products:
#   - 路径规划 (driving / walking / bicycling / transit)
#   - 地理编码 (regeo)
#   - 搜索 (place/text)
MAP_PROVIDER=amap_web
MAP_API_KEY=
MAP_WEB_KEY=

# App Settings fields:
#   Map Web Key  → MAP_WEB_KEY (device preferences; required for live)
#   Map API Key  → optional SDK slot (not used by Hybrid REST path yet)
#   演示 Fixture 优先 → when ON, force estimate even if MAP_WEB_KEY present

# --- LLM Mode A: direct OpenAI-compatible vendor ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- LLM Mode B: optional proxy ---
PROXY_BASE_URL=http://127.0.0.1:8787
# server-side only:
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-chat
HOST=0.0.0.0
PORT=8787

# --- Feature flags ---
DEMO_FIXTURES=true
LLM_ENABLED=true
VERBOSE_AGENT_TRACE=false
