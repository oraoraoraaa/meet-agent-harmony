# Local configuration template
# Copy to .env (repo root) or app secure settings — never commit real secrets.

# --- Map provider (choose fields you actually use) ---
MAP_PROVIDER=harmony_map_kit_or_amap
MAP_API_KEY=
MAP_WEB_KEY=

# --- LLM Mode A: direct OpenAI-compatible vendor ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- LLM Mode B: optional proxy ---
PROXY_BASE_URL=http://127.0.0.1:8787
# server-side only:
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=
UPSTREAM_MODEL=deepseek-chat
HOST=0.0.0.0
PORT=8787

# --- Feature flags ---
DEMO_FIXTURES=false
LLM_ENABLED=true
VERBOSE_AGENT_TRACE=false
